{% for task_idx in range(1, (task_count or 5) + 1) %}
---
apiVersion: tekton.dev/v1
kind: Task
metadata:
  name: echo{{task_idx}}
spec:
  description: "Just hello world task"
  params: []
  results: []
  steps:
    {% for idx in range(1, (step_count or 10) + 1) %}
    - name: echo{{ idx }}
      image: registry.redhat.io/ubi8/ubi-minimal@sha256:574f201d7ed185a9932c91cef5d397f5298dff9df08bc2ebb266c6d1e6284cd1
      script: |
        #!/usr/bin/env bash
        set -euo pipefail
        {%- if log_bytes_per_step | default(0) | int > 0 %}
        # Generate stdout at runtime without expanding the Task manifest.
        # Each full line is 1024 bytes including its newline.
        printf -v line '%1023s' ''
        line=${line// /x}
        bytes={{ log_bytes_per_step }}
        for ((remaining=bytes; remaining>=1024; remaining-=1024)); do
          printf '%s\n' "$line"
        done
        if (( remaining > 0 )); then
          printf '%.*s\n' "$((remaining - 1))" "$line"
        fi
        {%- else %}
        {%- for line_idx in range(1, (line_count or 15) + 1) %}
        echo "Hello World Chains Performance Benchmark Test {{ (idx - 1) * (line_count or 15) + line_idx }} from Task{{task_idx}}"{% endfor %}
        {%- endif %}

    {% endfor %}
{% endfor %}
---
apiVersion: tekton.dev/v1
kind: Pipeline
metadata:
  name: echo
spec:
  params: []
  tasks:
  {% for task_idx in range(1, (task_count or 5) + 1) %}
    - name: echo{{task_idx}}
      taskRef:
        name: echo{{task_idx}}
      params: []
  {% endfor %}
